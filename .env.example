# Server-only secrets; never commit .env files.
OPENAI_API_KEY=
# Required on Vercel: a PostgreSQL connection URL (for example, pooled Neon).
DATABASE_URL=
# Local fallback only. Vercel NEVER writes a database to its temporary filesystem.
DATABASE_PATH=./data/studio.sqlite
APP_ORIGIN=http://localhost:3000
# Quotas count images, including each image in a multi-image request.
USER_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=100
USER_PENDING_LIMIT=3
MAX_CONCURRENT_JOBS=2
USER_STORAGE_MB=1024
